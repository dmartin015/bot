# Copia este archivo a .env y rellénalo. NUNCA subas .env a Git ni lo pegues en un chat.
# El token viejo que se pegó en el chat está expuesto: revócalo en @BotFather con /revoke
# y usa aquí el nuevo.

# Token nuevo del bot (de @BotFather, tras /revoke)
BOT_TOKEN=

# Canal donde avisa de caídas. El bot tiene que ser administrador del canal.
# Puede ser el ID numérico (ej. -1001234567890) o el @ del canal (ej. @stremio-nuvio-avisos).
# Para sacar el ID: reenvía un mensaje del canal a @userinfobot o a @getmyid_bot.
ALERT_CHANNEL_ID=

# Cada cuántos minutos revisa los addons (por defecto 5)
CHECK_INTERVAL_MINUTES=5

# Fallos seguidos antes de avisar de una caída (por defecto 2, anti falsos positivos)
FAILS_TO_ALERT=2
